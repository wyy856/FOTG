+    def loss_unk(self, outputs, targets, indices, num_boxes, log=True, aux_level=-1):
+        """Independent unknown/objectness head loss (ADDITIVE; off when no unk head).
+
+        Supervision is derived from the SAME Hungarian assignment used for known classes,
+        so the known matching path is left completely unchanged:
+          - a prediction matched (by the matcher) to a pseudo-unknown box
+            (target label == num_classes-1 == unk_idx) becomes an unk POSITIVE;
+          - predictions matched to known boxes are confident unk NEGATIVES;
+          - unmatched predictions are cautious low-weight negatives (weight 0.1) so that
+            genuine unknown misses are not over-penalised (unknown pseudo-labels are noisy).
+        If the unk head is disabled (model.unk_head is None) or pred_unk is absent, this
+        returns {} so the behaviour is byte-identical to the baseline. Only the final
+        decoder layer is supervised (aux_level == -1) to keep the loss minimal.
+        """
+        if self.model is None or getattr(self.model, 'unk_head', None) is None or 'pred_unk' not in outputs:
+            return {}
+        if aux_level != -1:
+            return {}
+        pred_unk = outputs['pred_unk'].squeeze(-1)            # [B, Q]
+        B, Q = pred_unk.shape
+        device = pred_unk.device
+        tgt = torch.zeros(B, Q, dtype=torch.float32, device=device)
+        weight = torch.full((B, Q), 0.1, dtype=torch.float32, device=device)  # cautious neg for unmatched
+        unk_idx = self.num_classes - 1
+        for i, (pred_idx, tgt_idx) in enumerate(indices):
+            # Device-proof: matcher indices and target labels may live on different
+            # devices (targets can stay on CPU while matcher runs on GPU).
+            tgt_labels = targets[i]['labels'].to(device)
+            matched_labels = tgt_labels[tgt_idx.to(device)]
+            unk_mask = (matched_labels == unk_idx)
+            pred_idx_d = pred_idx.to(device)
+            pos_pred = pred_idx_d[unk_mask]
+            tgt[i, pos_pred] = 1.0
+            weight[i, pos_pred] = 1.0                 # positive: full weight
+            known_mask = ~unk_mask
+            weight[i, pred_idx_d[known_mask]] = 1.0    # matched known: confident negative
+        ce = F.binary_cross_entropy_with_logits(pred_unk, tgt, reduction='none')  # [B, Q]
+        denom = weight.sum().clamp(min=1.0)
+        loss = (ce * weight).sum() / denom
+        losses = {'loss_unk': loss}
+        if log:
+            with torch.no_grad():
+                p = pred_unk.sigmoid()
+                tp = ((p > 0.5) & (tgt > 0.5)).float().sum()
+                fp = ((p > 0.5) & (tgt < 0.5)).float().sum()
+                n_pos = tgt.sum().clamp(min=1.0)
+                losses['unk_recall'] = tp / n_pos
+                losses['unk_precision'] = tp / (tp + fp).clamp(min=1.0)
+                losses['unk_n_pos'] = n_pos
+        return losses
+
